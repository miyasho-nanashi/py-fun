# .keep files matching expressions for the 'find' command:
# - find . $(cat .keep)
# 
-path \*__pycache__
-o \(
 # exclude paths and files to preserve:
 ! -path .
 ! -path ./src
 ! -path ./tests
 ! -path ./docs
 ! -path ./docs/index.rst
 ! -path ./\*/calculator
 ! -path ./\*/collections

 # exclude anything in paths
 ! -path ./.git\*
 ! -path ./.vscode\*
 ! -path ./.devcontainer\*
 ! -path ./markup\*
 ! -path ./tmp\*

 # exclude files
 ! -name .keep
 ! -name Makefile
 ! -name README.md
 ! -name requirements.txt
 ! -name \*.py

 # exclude content removed with the directory
 ! -path \*__pycache__/*
 ! -path ./.pytest_cache/\*
 ! -path \*.egg-info/\*
 ! -path \*doctrees/\*
 ! -path \*html/\*
\)
